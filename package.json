{
  "name": "@raintree-technology/trellis",
  "version": "0.3.0",
  "description": "Anti-slop Biome policy for Raintree Technology projects",
  "author": "Raintree Technology",
  "license": "MIT",
  "keywords": [
    "biome",
    "configuration",
    "gritql",
    "lint",
    "policy"
  ],
  "bin": {
    "trellis": "./bin/trellis.mjs"
  },
  "exports": {
    "./biome": "./config/trellis.json",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "config",
    "docs/rules",
    "plugins",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "check": "biome check .",
    "check:fixtures": "bun test tests",
    "check:write": "biome check . --write",
    "package:check": "npm pack --dry-run",
    "prepublishOnly": "bun run check && bun run check:fixtures && bun run package:check",
    "trellis": "bun bin/trellis.mjs"
  },
  "peerDependencies": {
    "@biomejs/biome": "2.5.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6"
  },
  "packageManager": "bun@1.3.11",
  "engines": {
    "node": "24.x"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raintree-technology/trellis.git"
  },
  "bugs": {
    "url": "https://github.com/raintree-technology/trellis/issues"
  },
  "homepage": "https://github.com/raintree-technology/trellis#readme"
}
